  m_Name: 
  m_EditorClassIdentifier: '::'
  texteDialogue: {fileID: 0}
  dialogues:
  - "L'aventure en for\xEAt approche ! Pr\xE9pare ton \xE9quipement avant la fin
    du chrono et n'oublie pas d'aller magasiner \xE0 la boutique de camping pour
    acheter tout ce qu'il te faut !"
  - "Une journ\xE9e \xE0 la plage t'attend ! Pr\xE9pare-toi avant que le chrono arrive
    \xE0 z\xE9ro et passe \xE0 la boutique de plage pour acheter tout le n\xE9cessaire
    !"
  - "Direction les montagnes enneig\xE9es ! Tu dois te pr\xE9parer avant la fin du
    chrono. Va magasiner \xE0 la boutique de ski pour \xEAtre pr\xEAt \xE0 d\xE9valer
    les pistes !"
  delaiEntreMots: 0.4
  boutonDemarrer: {fileID: 0}
  texteChrono: {fileID: 0}
  dureeChrono: 60
